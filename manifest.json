{
  "manifest_version": 3,
  "name": "ZoomClip — Screen Recorder",
  "version": "1.0.0",
  "description": "Record the current tab and capture click events with timestamps.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "ZoomClip"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabCapture",
    "activeTab",
    "storage",
    "offscreen",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
